
{{!-- {{> navbar}}
    </div>

    {{#if cart.products.length}}

        <div class="side-cart-products">

            {{#each cart.products}}

                <div class="side-cart-item">

                    <img
                        src="{{this.product.thumbnails.[0]}}"
                        alt="{{this.product.title}}"
                        class="side-cart-image"
                    >

                    <div class="side-cart-info">

                        <h3>
                            {{this.product.title}}
                        </h3>

                        <p class="side-cart-price">
                            ${{this.product.price}}
                        </p>

                        <p class="side-cart-qty">
                            Cantidad: {{this.quantity}}
                        </p>

                    </div>

                </div>

            {{/each}}

        </div>

        <div class="side-cart-footer">

            <button class="clear-cart-btn">
                Vaciar carrito
            </button>

            <button class="checkout-btn">
                Finalizar compra
            </button>

        </div>

    {{else}}

        <div class="empty-cart">

            <p>
                Tu carrito está vacío
            </p>

            <a
                href="/products"
                class="continue-shopping"
            >
                Ver productos
            </a>

        </div>

    {{/if}}

</aside>

{{> footer}} --}}