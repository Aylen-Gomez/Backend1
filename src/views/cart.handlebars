<h1>Carrito</h1>

{{#if cart.products.length}}

    {{#each cart.products}}

        <div class="product-card">

            <h2>
                {{this.product.title}}
            </h2>

            <p>
                Precio:
                ${{this.product.price}}
            </p>

            <p>
                Cantidad:
                {{this.quantity}}
            </p>

            <hr>

        </div>

    {{/each}}

{{else}}

    <p>
        El carrito está vacío
    </p>

{{/if}}