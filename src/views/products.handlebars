
{{> navbar}}

<!-- ========================= -->
<!-- TERMOS -->
<!-- ========================= -->

<section id="termos">

    <section class="featured-banner">

        <h2>
            TERMOS
        </h2>

    </section>

    <div class="products-container">

        {{#each products}}

            {{#if (eq this.category "Termos")}}

                <div class="product-card">

                    <img
                        src="{{this.thumbnails.[0]}}"
                        alt="{{this.title}}"
                        class="product-image"
                    />

                    <h2 class="product-title">

                        <a href="/products/{{this._id}}">
                            {{this.title}}
                        </a>

                    </h2>

                    <p class="product-price">
                        ${{this.price}}
                    </p>

                    <p class="product-installments">
                        3 cuotas sin interés
                    </p>

                    <a
                        href="/products/{{this._id}}"
                        class="view-product-btn"
                    >
                        Ver producto
                    </a>

                </div>

            {{/if}}

        {{/each}}

    </div>

</section>

