{{!-- <h1>Productos</h1> --}}

<div class="products-container">

    {{#each products}}

        <div class="product-card">

    <img
        src="{{this.thumbnails.[0]}}"
        alt="{{this.title}}"
        class="product-image"
    />

    <h2 class="product-title">

        <a href="/products/{{this._id}}">
            {{this.title}}
        </a>

    </h2>

    <p class="product-price">
        ${{this.price}}
    </p>

    <p class="product-installments">
        3 cuotas sin interés
    </p>

    <a
        href="/products/{{this._id}}"
        class="view-product-btn"
    >
        Ver producto
    </a>

</div>

    {{/each}}

</div>

<div class="pagination">

    {{#if hasPrevPage}}

        <a href="{{prevLink}}">
            ⬅ Página anterior
        </a>

    {{/if}}

    <p>
        Página {{page}} de {{totalPages}}
    </p>

    {{#if hasNextPage}}

        <a href="{{nextLink}}">
            Página siguiente ➡
        </a>

    {{/if}}

</div>