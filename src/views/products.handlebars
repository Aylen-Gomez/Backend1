<script>

    function showToast(message) {

        const toast =
            document.createElement("div")

        toast.classList.add("custom-toast")

        toast.innerText = message

        document.body.appendChild(toast)

        setTimeout(() => {

            toast.classList.add("show")

        }, 100)

        setTimeout(() => {

            toast.classList.remove("show")

            setTimeout(() => {

                toast.remove()

            }, 300)

        }, 2500)

    }

</script>

