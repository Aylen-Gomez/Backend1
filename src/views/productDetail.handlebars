<h1>Detalle del producto</h1>

<div class="product-detail">

    <h2>{{product.title}}</h2>

    <p>{{product.description}}</p>

    <p>Precio: ${{product.price}}</p>

    <p>Categoría: {{product.category}}</p>

    <p>Stock: {{product.stock}}</p>

    <p>Código: {{product.code}}</p>

    <button>
        Agregar al carrito
    </button>

</div>

<a href="/products">
    Volver a productos
</a>