<script>

    const cartId =
        "6a091f5ec5adea56c2610400"

    async function loadCartCount() {

        try {

            const response =
                await fetch(
                    `/api/carts/${cartId}`
                )

            const cart =
                await response.json()

            let total = 0

            cart.products.forEach(product => {

                total += product.quantity

            })

            document.getElementById(
                "cart-badge"
            ).innerText = total

        } catch (error) {

            console.log(error)

        }

    }

    loadCartCount()

</script>

<script>

    async function openCart() {

        document.getElementById(
            "cartSidebar"
        ).classList.add("active")

        document.getElementById(
            "cartOverlay"
        ).classList.add("active")

        await loadCartItems()

    }

    function closeCart() {

        document.getElementById(
            "cartSidebar"
        ).classList.remove("active")

        document.getElementById(
            "cartOverlay"
        ).classList.remove("active")

    }

    async function loadCartItems() {

        const response =
            await fetch(`/api/carts/${cartId}`)

        const cart =
            await response.json()

        const container =
            document.getElementById(
                "cartItems"
            )

        if (!cart.products.length) {

            container.innerHTML = `

                <div class="empty-cart">

                    <p>
                        El carrito está vacío
                    </p>

                </div>

            `

            return

        }

        container.innerHTML =
            cart.products.map(item => `

                <div class="cart-item">

                    <img
                        src="${item.product.thumbnails[0]}"
                    >

                    <div>

                        <h4>
                            ${item.product.title}
                        </h4>

                        <p>
                            $${item.product.price}
                        </p>

                        <span>
                            Cantidad:
                            ${item.quantity}
                        </span>

                    </div>

                </div>

            `).join("")

    }

    async function clearCart() {

        await fetch(

            `/api/carts/${cartId}`,

            {
                method: "DELETE"
            }

        )

        loadCartItems()

        loadCartCount()

    }

</script>
