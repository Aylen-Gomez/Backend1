{{> navbar}}
<div class="realtime-container">

    <div class="realtime-header">

        <h1>
            Panel de productos
        </h1>

        <p>
            Gestión en tiempo real de productos Boreal
        </p>

    </div>

    <form
        id="productForm"
        class="realtime-form"
    >

        <div class="form-group">

            <label>
                Nombre
            </label>

            <input
                type="text"
                name="title"
                placeholder="Botella Boreal Active"
                required
            >

        </div>

        <div class="form-group">

            <label>
                Precio
            </label>

            <input
                type="number"
                name="price"
                placeholder="$45000"
                required
            >

        </div>

        <div class="form-group">

            <label>
                Categoría
            </label>

            <input
                type="text"
                name="category"
                placeholder="Botellas"
            >

        </div>

        <div class="form-group">

            <label>
                Stock
            </label>

            <input
                type="number"
                name="stock"
                placeholder="20"
            >

        </div>

        <div class="form-group full-width">

            <label>
                Descripción
            </label>

            <textarea
                name="description"
                placeholder="Descripción del producto..."
            ></textarea>

        </div>

        <div class="form-group full-width">

            <label>
                Imagen URL
            </label>

            <input
    type="file"
    name="thumbnail"
    id="thumbnailInput"
    accept="image/*"
>

        </div>

        <button
            type="submit"
            class="realtime-btn"
        >

            Agregar producto

        </button>

    </form>

    <hr>

    <div
        id="productsContainer"
        class="realtime-products"
    >

    </div>

</div>

{{> footer}}

<script src="/socket.io/socket.io.js"></script>
<script src="/js/realtime.js"></script>