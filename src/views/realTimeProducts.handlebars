<h1>Productos en tiempo real</h1>

<form id="productForm">

    <input
        type="text"
        name="title"
        placeholder="Titulo"
        required
    >

    <input
        type="number"
        name="price"
        placeholder="Precio"
        required
    >

    <button type="submit">
        Agregar producto
    </button>

</form>

<hr>

<div id="productsContainer">

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/realtime.js"></script>